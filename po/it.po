msgstr "Gli altri possono trovare questo computer e inviargli file"

#: src/shell/qml/SettingsPage.qml:71
msgid "Hide during Do Not Disturb"
msgstr "Nascondi durante Non disturbare"

#: src/shell/qml/SettingsPage.qml:72
msgid "Not visible while Do Not Disturb is on"
msgstr "Non visibile mentre Non disturbare è attivo"

#: src/shell/qml/SettingsPage.qml:80
msgid "Receiving"
msgstr "Ricezione"

#: src/shell/qml/SettingsPage.qml:86
