msgid "KuickShare"
msgstr "KuickShare"

#: src/shell/qml/Main.qml:97
msgid "Quit KuickShare?"
msgstr "Uscire da KuickShare?"

#: src/shell/qml/Main.qml:98
msgid "A transfer is in progress. Quitting stops it."
msgstr "Un trasferimento è in corso. Uscendo verrà interrotto."

#: src/shell/qml/Main.qml:205 src/shell/qml/ShortcutsDialog.qml:12
#: src/shell/qml/TransfersPage.qml:11
msgid "Transfers"
